# Copia este archivo como ".env.local" (ese archivo NUNCA se sube a git)
# y rellena los valores desde el panel de tu proyecto en supabase.com:
# Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Envío de correos de confirmación/cancelación (resend.com).
# Sin estas dos variables, la app sigue funcionando: el enlace de
# cancelación simplemente se muestra en pantalla en vez de enviarse.
RESEND_API_KEY=re_TU_CLAVE
RESEND_FROM=onboarding@resend.dev

# URL pública del sitio, usada para armar el enlace de cancelación en el
# correo. En local puedes dejarla así; en producción debe ser tu dominio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
